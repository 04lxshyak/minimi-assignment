# API Keys
# Google Gemini (FREE) — get yours at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Tavily Search (FREE 1000 searches/month) — get yours at https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Optional: choose google or openai if both model keys are configured
# LLM_PROVIDER=google

# ── Optional: Use OpenAI instead of Gemini ────────────────────────
# If you set OPENAI_API_KEY (and remove GOOGLE_API_KEY), the agent
# will use OpenAI GPT-4o instead. This is a paid API.
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Model Configuration (optional)
# MODEL_NAME=gemini-2.0-flash   # Default for Google
# MODEL_NAME=gpt-4o             # Default for OpenAI

# Agent Configuration (optional)
# MAX_CONTEXT_MESSAGES=40     # Messages kept in LLM context window
# MAX_SEARCH_RESULTS=6        # Results per web search
# MAX_AGENT_STEPS=10          # Max tool-calling iterations per turn
# DB_PATH=./data/memory.db    # SQLite database path
# TIME_ZONE=Asia/Kolkata     # Calendar timezone for memory/date references
