# API Keys (required)
OPENAI_API_KEY=sk-your-openai-api-key-here
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Model Configuration (optional)
# MODEL_NAME=gpt-4o          # OpenAI model to use (default: gpt-4o)

# Agent Configuration (optional)
# MAX_CONTEXT_MESSAGES=40     # Max messages kept in LLM context window (default: 40)
# MAX_SEARCH_RESULTS=6        # Max results per web search (default: 6)
# MAX_AGENT_STEPS=10          # Max tool-calling iterations per turn (default: 10)

# Storage (optional)
# DB_PATH=./data/memory.db    # SQLite database path (default: ./data/memory.db)
